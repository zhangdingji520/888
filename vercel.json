{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/flight-search run build",
  "outputDirectory": "artifacts/flight-search/dist/public",
{
  "functions": {
    "api/*.php": {
      "runtime": "@vercel/php@4.0.0"
    }
  }
}
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
